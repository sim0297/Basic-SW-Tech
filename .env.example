# .env 템플릿 — `cp .env.example .env` 후 값을 채우세요.

# ── Ollama / 로컬 LLM (필수) ──
OLLAMA_BASE_URL={Ollama 서버 URL}
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL={모델명}

# ── Cloud API 키 (선택 — 비워두면 로컬 LLM 만 사용) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── App (필수) ──
APP_PORT={포트 번호}
MAX_UPLOAD_SIZE_MB=100
